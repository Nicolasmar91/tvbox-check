---
import Base from "../../layouts/Base.astro";
import { db } from "../../lib/db";
import { fr } from "../../i18n/fr";
---

<Base title={fr.soc.indexTitle} description={fr.soc.indexDescription}>
  <h1>{fr.soc.indexTitle}</h1>
  <p class="lead">{fr.soc.indexDescription}</p>
  <div class="table-scroll">
    <table>
      <thead>
        <tr>
          <th scope="col">SoC</th>
          <th scope="col">{fr.fields.ramMax}</th>
          <th scope="col">{fr.fields.ethernetMax}</th>
          <th scope="col">{fr.fields.videoMax}</th>
        </tr>
      </thead>
      <tbody>
        {db.socs.map((s) => (
          <tr>
            <th scope="row">
              <a href={`/soc/${s.id}/`}>
                {s.vendor} {s.name}
              </a>
            </th>
            <td>
              {s.ram_max_gb ? `${s.ram_max_gb.value} ${fr.fields.gb}` : fr.fields.unknownValue}
              {s.ram_max_gb && (
                <span class={`tag ${s.ram_max_gb.status}`}>{fr.basis[s.ram_max_gb.basis]}</span>
              )}
            </td>
            <td>
              {s.ethernet_max_mbps
                ? `${s.ethernet_max_mbps.value} ${fr.fields.mbps}`
                : fr.fields.unknownValue}
            </td>
            <td>{s.video_max_decode ? s.video_max_decode.value : fr.fields.unknownValue}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</Base>
