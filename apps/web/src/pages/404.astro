---
import Base from "../layouts/Base.astro";
import { routePath, useT } from "../i18n";

const fr = useT("fr");
const en = useT("en");
---

<Base title={fr.ui.notFoundTitle} description={fr.ui.notFoundText} lang="fr">
  <h1>{fr.ui.notFoundTitle}</h1>
  <p class="lead">{fr.ui.notFoundText}</p>
  <p class="actions">
    <a class="btn" href={routePath("fr", "home")}>
      {fr.ui.backToChecker}
    </a>
    <a class="btn secondary" href={routePath("fr", "search")}>
      {fr.ui.searchSocOrModel}
    </a>
  </p>
  <hr />
  <h2 lang="en">{en.ui.notFoundTitle}</h2>
  <p lang="en">{en.ui.notFoundText}</p>
  <p class="actions" lang="en">
    <a class="btn secondary" href={routePath("en", "home")}>
      {en.ui.backToChecker}
    </a>
    <a class="btn secondary" href={routePath("en", "search")}>
      {en.ui.searchSocOrModel}
    </a>
  </p>
</Base>
