---
import { getSources, sourceTitle } from "../lib/db";
import { fmt, useT } from "../i18n";
import type { Lang } from "../i18n";

interface Props {
  ids: readonly string[];
  lang: Lang;
}
const { ids, lang } = Astro.props;
const t = useT(lang);
const list = getSources(ids);
---

{list.length > 0 && (
  <ul class="plain" style="margin:0.3rem 0">
    {list.map((s) => (
      <li>
        <a href={s.url} rel="noopener noreferrer" target="_blank">
          {sourceTitle(lang, s)}
        </a>{" "}
        <span class="hint">
          ({fmt(t.ui.sourceMeta, { type: t.sourceType[s.type], date: s.accessed })})
        </span>
      </li>
    ))}
  </ul>
)}
