{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "vendor": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cores": {
      "anyOf": [
        {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "arch": {
      "type": [
        "string",
        "null"
      ]
    },
    "ram_max_gb": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "value": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "status": {
              "type": "string",
              "enum": [
                "verified",
                "unverified"
              ]
            },
            "sources": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "value",
            "status",
            "sources"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "ram_types": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "value": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "status": {
              "type": "string",
              "enum": [
                "verified",
                "unverified"
              ]
            },
            "sources": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "value",
            "status",
            "sources"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "ethernet_max_mbps": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "value": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "status": {
              "type": "string",
              "enum": [
                "verified",
                "unverified"
              ]
            },
            "sources": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "value",
            "status",
            "sources"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "video_max_decode": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "value": {
              "type": "string",
              "enum": [
                "1080p",
                "4K",
                "6K",
                "8K"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "verified",
                "unverified"
              ]
            },
            "sources": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "value",
            "status",
            "sources"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "notes_fr": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "id",
    "vendor",
    "name",
    "aliases",
    "cores",
    "arch",
    "ram_max_gb",
    "ram_types",
    "ethernet_max_mbps",
    "video_max_decode",
    "notes_fr"
  ],
  "additionalProperties": false
}
