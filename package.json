{
  "name": "tvbox-check",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --check .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/web",
    "test": "vitest run",
    "validate": "tsx scripts/validate-data.ts",
    "schemas": "tsx scripts/generate-schemas.ts",
    "check": "pnpm lint && pnpm format && pnpm typecheck && pnpm validate && pnpm test && pnpm build && pnpm i18n",
    "build": "pnpm --filter @tvbox-check/web build",
    "i18n": "tsx scripts/check-i18n.ts"
  },
  "devDependencies": {
    "@tvbox-check/core": "workspace:^",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  }
}
